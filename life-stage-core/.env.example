# LIFE STAGE COMMON CORE — 環境変数（名前のみ。値は Vercel / .env.local に設定し Git にコミットしない）
# Supabase（Settings > API Keys）。publishable key のみ使用。secret / service_role キーはアプリでは使用しない。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 招待リンク・OAuth リダイレクトの基準URL（例：https://core-dev.example.com）
NEXT_PUBLIC_SITE_URL=http://localhost:3000
