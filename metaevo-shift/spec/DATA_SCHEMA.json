{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.metaevo-shift.invalid/exports/v2.1.json",
  "$comment": "This URL is a placeholder for schema identity, not a network endpoint.",
  "title": "MetaEVO Shift local data export schema v2.1",
  "type": "object",
  "required": [
    "schemaVersion",
    "createdAt",
    "preferences",
    "workshop",
    "goals",
    "experiments",
    "dayPlans",
    "events",
    "evidence",
    "reviews",
    "lifeCompass",
    "lifeTime"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "preferences": {
      "type": "object",
      "required": [
        "timeZone",
        "dataSharing"
      ],
      "properties": {
        "timeZone": {
          "type": "string"
        },
        "dataSharing": {
          "const": "private"
        },
        "lastBackupAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "displayTheme": {
          "enum": [
            "dark",
            "light",
            "system"
          ]
        }
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "currentChallenge": {
          "type": [
            "string",
            "null"
          ]
        },
        "valueDrafts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motivations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sharingResistance": {
          "type": [
            "string",
            "null"
          ]
        },
        "selectedRoute": {
          "enum": [
            "explore",
            "protect",
            "plan",
            "execute"
          ]
        }
      }
    },
    "workshop": {
      "type": "object",
      "required": [
        "status",
        "answers"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "in_progress",
            "completed"
          ]
        },
        "startedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "completedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "answers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean",
              "null",
              "array",
              "object"
            ]
          }
        },
        "selectedRoute": {
          "enum": [
            "explore",
            "protect",
            "plan",
            "execute"
          ]
        },
        "initialExperimentId": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "goals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/goal"
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experiment"
      }
    },
    "dayPlans": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dayPlan"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "lifeCompass": {
      "type": "object",
      "required": [
        "status",
        "visibility"
      ],
      "properties": {
        "status": {
          "enum": [
            "exploring",
            "provisional",
            "committed",
            "paused"
          ]
        },
        "visibility": {
          "const": "private"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "desiredWayOfLiving": {
          "type": [
            "string",
            "null"
          ]
        },
        "lifePrinciple": {
          "type": [
            "string",
            "null"
          ]
        },
        "longTermPurpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "changedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "previousText": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "lifeTime": {
      "type": "object",
      "required": [
        "enabled",
        "displayMode",
        "homeCard",
        "visibility",
        "reflections",
        "reflectionToPlanLinks"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "displayMode": {
          "enum": [
            "reflection",
            "year",
            "weeks"
          ]
        },
        "homeCard": {
          "enum": [
            "off",
            "gentle"
          ]
        },
        "visibility": {
          "const": "private"
        },
        "birthDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "birthYear": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1900,
          "maximum": 2100
        },
        "planningHorizonAge": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 120
        },
        "optedInAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "reflections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "questionId",
              "recordedAt"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "questionId": {
                "enum": [
                  "LT00",
                  "LT01",
                  "LT02",
                  "LT03",
                  "LT04",
                  "LT05"
                ]
              },
              "recordedAt": {
                "type": "string",
                "format": "date-time"
              },
              "answer": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "linkedPlanId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "kind": {
                "enum": [
                  "values",
                  "weekly",
                  "daily",
                  "other"
                ]
              }
            }
          }
        },
        "reflectionToPlanLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "reflectionId",
              "planId"
            ],
            "properties": {
              "reflectionId": {
                "type": "string"
              },
              "planId": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "goal": {
      "type": "object",
      "required": [
        "id",
        "status",
        "title",
        "sharing",
        "createdAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "exploring",
            "provisional",
            "committed",
            "paused",
            "retired"
          ]
        },
        "title": {
          "type": "string"
        },
        "purpose": {
          "type": [
            "string",
            "null"
          ]
        },
        "targetDate": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "sharing": {
          "const": "private"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "revisedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "outcomeMeasureId": {
          "type": [
            "string",
            "null"
          ]
        },
        "priorityReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "expectedOutcome": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "experiment": {
      "type": "object",
      "required": [
        "id",
        "route",
        "theme",
        "experimentKind",
        "firstAction",
        "startCue",
        "startDate",
        "endDate",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "route": {
          "enum": [
            "explore",
            "protect",
            "plan",
            "execute"
          ]
        },
        "theme": {
          "type": "string"
        },
        "experimentKind": {
          "enum": [
            "exploration",
            "learning",
            "execution"
          ]
        },
        "firstAction": {
          "type": "string"
        },
        "startCue": {
          "type": "string"
        },
        "fallbackPlan": {
          "type": [
            "string",
            "null"
          ]
        },
        "startDate": {
          "type": "string",
          "format": "date"
        },
        "endDate": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "draft",
            "active",
            "completed",
            "paused",
            "retired"
          ]
        },
        "hypothesisIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidenceMeasureIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "dayPlan": {
      "type": "object",
      "required": [
        "id",
        "localDate",
        "dayMode",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "localDate": {
          "type": "string",
          "format": "date"
        },
        "dayMode": {
          "enum": [
            "advance",
            "prepare",
            "recover"
          ]
        },
        "status": {
          "enum": [
            "unplanned",
            "planned",
            "in_progress",
            "paused",
            "completed",
            "not_started",
            "changed",
            "rest",
            "unknown"
          ]
        },
        "experimentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "importantAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "startCue": {
          "type": [
            "string",
            "null"
          ]
        },
        "plannedMinutes": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "plannedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "priorityReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "displacedActivity": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "occurredAt",
        "localDate"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "PLAN_CREATED",
            "ACTION_STARTED",
            "ACTION_PAUSED",
            "ACTION_COMPLETED",
            "INTERNAL_SWITCH",
            "EXTERNAL_INTERRUPT",
            "ACTION_RESUMED",
            "REPLAN",
            "REST_CHOSEN",
            "DAILY_REVIEW",
            "HYPOTHESIS_REVISED",
            "GOAL_REVISED",
            "EVIDENCE_ADDED"
          ]
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "localDate": {
          "type": "string",
          "format": "date"
        },
        "planId": {
          "type": [
            "string",
            "null"
          ]
        },
        "payload": {
          "type": "object"
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": [
        "id",
        "layer",
        "observedAt",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "layer": {
          "enum": [
            "action",
            "learning",
            "outcome",
            "alignment"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "description": {
          "type": "string"
        },
        "goalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "experimentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "quantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "baselineQuantity": {
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "enum": [
            "self_report",
            "record",
            "external_document",
            "other"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "required": [
        "id",
        "reviewKind",
        "reviewedAt"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reviewKind": {
          "enum": [
            "day7",
            "day14",
            "day30",
            "day60",
            "day90",
            "daily",
            "custom"
          ]
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "periodStart": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "periodEnd": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "facts": {
          "type": [
            "string",
            "null"
          ]
        },
        "hypothesisStatus": {
          "enum": [
            "supported",
            "contradicted",
            "insufficient",
            "rejected",
            "not_applicable"
          ]
        },
        "nextAction": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
