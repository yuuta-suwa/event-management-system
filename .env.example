# 必須。日時の入力・表示を日本時間で一致させるため。秘密情報ではない。
TZ="Asia/Tokyo"
DATABASE_URL="postgresql://event_user:change-me@localhost:5432/event_management?schema=public"
AUTH_SECRET="replace-with-at-least-32-random-characters"
AUTH_TRUST_HOST="true"
QR_TOKEN_SECRET="replace-with-an-independent-32-character-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_MESSAGING_ACCESS_TOKEN=""
# 任意。LINE公式アカウントの「ベーシックID」（@より後ろの部分、例: 024locis）。
# 設定すると参加者マイページに「友だち追加」ボタンが表示される。秘密情報ではない。
NEXT_PUBLIC_LINE_BASIC_ID=""
NOTIFICATION_JOB_SECRET="replace-with-an-independent-random-secret"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-before-running-seed"
# ローカル画面確認専用。本番環境では必ず false または未設定にすること。
ENABLE_LOCAL_DEMO_AUTH="false"
LOCAL_DEMO_EMAIL="admin@example.com"
LOCAL_DEMO_PASSWORD=""
